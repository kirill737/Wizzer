                    {
                        "id": "82a7e965-468a-7568-c41d-5a1373db0d7a",
                        "title": "Внешний вид и размер",
                        "value": 5
                    },
                    {
                        "id": "6589781d-4709-b066-d145-bf7ab134a235",
                        "title": "Производительность",
                        "value": 5
                    },
                    {
                        "id": "ca55e7c7-ef62-8c75-1aae-30211a177dba",
