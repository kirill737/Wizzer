                        "id": "da93c8cf-36f9-4257-a59b-40b725947732",
                        "thumbUrl": "https://c.dns-shop.ru/thumb/st1/crop/100/100/34096f258ae077b2912f91bb650da904/70a503adae9129cda3f8fa0c26f0fd0b10cdaff6476fb05ee0e8826f2b4bc306.jpeg"
