                "objectName": "6.78\" Смартфон Infinix HOT 40 Pro 256 ГБ зеленый",
                "user": {
                    "id": "3e493c68-0c0d-42df-8957-52df76f40ee6",
                    "avatar": "<img alt=\"\" data-src=\"https://c.dns-shop.ru/thumb/st1/crop/300/300/ed0faa3982c4814aa7ec1507c76b6476/bb6fa769bbe393c849a725fde858008447abd5d70bc1309ef92fa65760f39295.png\">",
